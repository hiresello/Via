# Keys from docs/via-grok-setup.md (and the Grok Bot account setup).
# Demo (`npm run demo`) needs none of these — stub rank.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Tonight’s demo guild (named Via). One id.
DISCORD_GUILD_ID=
# Optional sequel / multi-guild: comma-separated guild ids. Bot uses DISCORD_GUILD_ID
# when set; otherwise the first id in this list.
VIA_GUILD_IDS=

# --- OpenRouter (microsoft/microsoft-decision-1, Decisions / System One) ---
# POST https://openrouter.ai/api/v1/systemone — probabilities, not chat text.
# Missing key → model: stub. 404 on the slug → stub + “microsoft/microsoft-decision-1 was rejected”.
# Do not substitute another model.
OPENROUTER_API_KEY=

# --- Public origin of the thin pages (no trailing slash) ---
# After Vercel deploy, set to the production URL. Local demo default is fine.
VIA_PUBLIC_URL=http://localhost:8787

# Optional: absolute path to a display font. Default is fonts/Apestron.otf in this repo.
# VIA_DISPLAY_FONT=

# Optional overrides.
# VIA_DB_PATH=
# VIA_SEED_PATH=
# PORT=8787
# CHROME_PATH=
