{
  "version": 2,
  "builds": [
    {
      "src": "src/web/server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": ["data/**", "fonts/**", "public/**", "public/thumbs/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/web/server.js" }
  ]
}
